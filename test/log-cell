type Cell(val, merge) =
    mutable member _.value: int = val
    mutable member _.merge: bool = merge

let (++) (A: Cell) (B: Cell): unit = 
    if A.value = B.value and A.merge = true and B.merge = true then
        A.value <- 2*A.value
        A.merge <- false
    elif A.value = 0 then
        A.value <- B.value
        B.value <- 0
    else
        ()
        
let renderBoard (board: Board) =
    let tiles = board.getBoard
    let size = board.size
    let sep = "+" + String.replicate size "------+"
    for r in 0..size-1 do
        printfn "%s" sep
        for c in 0..size-1 do
            let v = tiles[r,c]
            if v = 0 then printf "|      "
            else printf "| %4d " v
        printfn "|"
    printfn "%s" sep